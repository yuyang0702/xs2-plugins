      "enable_reject_upstream": false,
      "max_reject_count": 3,
      "save_output_to_file": true,
      "output_file_path": "{{archive_observer_path}}",
      "sub_workflow_params": {},
      "auto_retry_count": 2,
      "auto_retry_interval_seconds": 5,
      "fail_auto_skip": false
